{% extends "default/module.html.jinja2" %}
{# Site chrome: the fixed nav bar and footer from axiom.org, vendored
   from the site's packages/ui (nav.tsx, footer.tsx, tokens.css) so
   axiom.org/receipt → /receipt/api reads as one site. Hrefs are
   absolute to https://axiom.org: the reference is proxied there
   same-origin, and the GitHub Pages origin then renders as a working
   mirror instead of a page of dead root-relative links. Sync here if
   the site nav or footer change. Small screens drop the middle link
   row (the footer carries every site link); pdoc's own hamburger
   stays the module navigation. #}
{% block body %}
<header class="axiom-site-nav">
    <div class="axiom-site-nav-inner">
        <a class="axiom-site-logo" href="https://axiom.org/" aria-label="Axiom Foundation">
            <img src="https://axiom.org/logos/axiom-foundation.svg" alt="Axiom Foundation" />
        </a>
        <div class="axiom-site-right">
            {# div, not <nav>: pdoc's layout.css fixed-positions every
               bare nav element at desktop widths. #}
            <div class="axiom-site-links" role="navigation" aria-label="Site">
                <a href="https://axiom.org/coverage">Coverage</a>
                <a href="https://axiom.org/validation">Validation</a>
                <a href="https://axiom.org/demos">What&rsquo;s possible</a>
                <a href="https://axiom.org/blog">Blog</a>
                <a href="https://axiom.org/about">About</a>
                <a href="https://axiom.org/team">Team</a>
            </div>
            <a class="axiom-site-gh" href="https://github.com/TheAxiomFoundation" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            </a>
            <a class="axiom-site-cta" href="https://axiom.org/app">Get started</a>
        </div>
    </div>
</header>
{{ super() }}
<footer class="axiom-site-footer">
    <div class="axiom-site-footer-inner">
        <div class="axiom-footer-grid">
            <div class="axiom-footer-brand">
                <img src="https://axiom.org/logos/axiom-foundation.svg" alt="Axiom Foundation" />
                <p class="axiom-footer-tagline">Computable law for all.</p>
                <p class="axiom-footer-blurb">Open, machine-readable encodings of the world&rsquo;s rules &mdash; starting with tax and benefit policy.</p>
                <div class="axiom-footer-socials">
                    <a href="https://github.com/TheAxiomFoundation" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg></a>
                    <a href="https://www.linkedin.com/company/axiom-foundation" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
                </div>
            </div>
            <div class="axiom-footer-col">
                <h3>Product</h3>
                <ul>
                    <li><a href="https://axiom.org/app">Axiom platform</a></li>
                    <li><a href="https://axiom.org/demos">Demos</a></li>
                    <li><a href="https://axiom.org/coverage">Coverage</a></li>
                    <li><a href="https://axiom.org/validation">Validation</a></li>
                    <li><a href="https://axiom.org/docs">Documentation</a></li>
                </ul>
            </div>
            <div class="axiom-footer-col">
                <h3>Foundation</h3>
                <ul>
                    <li><a href="https://axiom.org/about">About</a></li>
                    <li><a href="https://axiom.org/team">Team</a></li>
                    <li><a href="https://axiom.org/blog">Blog</a></li>
                    <li><a href="https://axiom.org/privacy">Privacy</a></li>
                </ul>
            </div>
            <div class="axiom-footer-col">
                <h3>Connect</h3>
                <ul>
                    <li><a href="https://axiom.org/contact">Contact</a></li>
                    <li><a href="mailto:hello@axiom.org?subject=Axiom%20updates">Get updates</a></li>
                    <li><a href="mailto:hello@axiom.org">hello@axiom.org</a></li>
                </ul>
            </div>
        </div>
        <div class="axiom-footer-bottom">
            <p>&copy; <span id="axiom-year">2026</span> Axiom Foundation &middot; Doing the public-interest work</p>
            <p class="axiom-footer-motto"><span class="axiom-glyph" aria-hidden="true">&forall;</span> Open infrastructure for encoded law</p>
        </div>
    </div>
</footer>
<script>document.getElementById("axiom-year").textContent = new Date().getFullYear();</script>
{% endblock %}
{# Kicker above the sidebar, mirroring the axiom.org/receipt header;
   links back to the package page for the seamless return path. #}
{% block nav_title %}
<a class="axiom-home" href="https://axiom.org/receipt">
    <span class="axiom-kicker"><span class="axiom-kicker-mark">&sect;</span>receipt</span>
    <span class="axiom-org">the Axiom Foundation</span>
</a>
{% endblock %}
{# Absolute-path values (import-time constants like CODE_ROOT) are
   sanitized before rendering by docs/build.py, which covers every
   surface pdoc serializes them into — HTML and the search.js index —
   and sweeps the output fail-closed. No template-level value filtering
   is needed here. #}

{# Same block as the default template, retitled to sentence case. #}
{% block nav_members %}
    {% if module.members %}
        <h2>API documentation</h2>
        {{ nav_members(module.members.values()) }}
    {% endif %}
{% endblock %}
